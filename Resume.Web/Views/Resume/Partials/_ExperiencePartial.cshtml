@model List<ExperienceViewModel>

<!-- Experience -->
<div class="section">
    <h2 class="title title--h2"><i class="fas fa-briefcase text-primary me-2"></i> سوابق و تجربیات کاری</h2>
    <div class="timeline">

        @foreach (ExperienceViewModel item in Model)
        {
            <!-- Item -->
            <article class="timeline__item">
                <h5 class="title title--h3 timeline__title">@item.Title</h5>
                @if (!string.IsNullOrWhiteSpace(item.StartDate) || !string.IsNullOrWhiteSpace(item.EndDate))
                {
                    <span class="timeline__period d-inline-block mt-1">
                        <i class="far fa-calendar-alt me-1 text-muted"></i>
                        @if (!string.IsNullOrWhiteSpace(item.StartDate) && !string.IsNullOrWhiteSpace(item.EndDate))
                        {
                            <span>@item.StartDate تا @item.EndDate</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(item.StartDate))
                        {
                            <span>از @item.StartDate</span>
                        }
                        else
                        {
                            <span>تا @item.EndDate</span>
                        }
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(item.Description))
                {
                    <p class="timeline__description">@item.Description</p>
                }
            </article>
        }

    </div>
</div>
