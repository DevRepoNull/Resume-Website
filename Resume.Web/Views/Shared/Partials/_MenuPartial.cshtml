@{
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString();
    var actionName = ViewContext.RouteData.Values["Action"]?.ToString();
}

<!-- Menu -->
<div class="circle-menu">
    <div class="hamburger">
        <div class="line"></div>
        <div class="line"></div>
        <div class="line"></div>
        <div class="hamburger__text">منو</div>
    </div>
</div>

<div class="nav-wrap">
    <div class="text-center py-2 d-none d-md-block">
        <a asp-controller="Home" asp-action="Index" title="صفحه اصلی">
            <img src="~/panel/images/logo.png" alt="لوگو وب‌سایت" class="site-nav-logo rounded-circle shadow-sm" style="max-height: 48px; max-width: 48px; object-fit: contain; background: #fff; padding: 4px;" />
        </a>
    </div>
    <ul class="nav">
        <li class="nav__item"><a asp-controller="Home" asp-action="Index" class="@(controllerName == "Home" && actionName == "Index" ? "active" : "")">درباره  من</a></li>
        <li class="nav__item"><a asp-controller="Resume" asp-action="Index" class="@(controllerName == "Resume" && actionName == "Index" ? "active" : "")">رزومه</a></li>
        <li class="nav__item"><a asp-controller="Portfolio" asp-action="Index" class="@(controllerName == "Portfolio" && actionName == "Index" ? "active" : "")">نمونه کار</a></li>
        <li class="nav__item"><a asp-controller="Contact" asp-action="Index" class="@(controllerName == "Contact" && actionName == "Index" ? "active" : "")">تماس با من</a></li>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <li class="nav__item"><a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-primary font-weight-bold"><i class="fa fa-tachometer-alt ms-1"></i>پنل مدیریت</a></li>
        }
    </ul>
</div>
