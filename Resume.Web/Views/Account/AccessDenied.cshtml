@{
    Layout = null;
    ViewData["Title"] = "عدم دسترسی";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link href="~/panel/css/style.css" rel="stylesheet">
    <style>
        body {
            font-family: Tahoma, 'Segoe UI', sans-serif;
            background-color: #f8f9fa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
        }
        .error-card {
            max-width: 500px;
            text-align: center;
            background: #ffffff;
            border-radius: 16px;
            padding: 40px 30px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }
        .error-code {
            font-size: 72px;
            font-weight: 800;
            color: #dc3545;
            line-height: 1;
            margin-bottom: 20px;
        }
        .btn-home {
            background-color: #2258bf;
            color: white;
            border-radius: 8px;
            padding: 10px 24px;
            text-decoration: none;
            display: inline-block;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="error-code">403</div>
        <h4 class="mb-3 text-dark">دسترسی غیرمجاز</h4>
        <p class="text-muted">شما مجوز دسترسی به این بخش از سامانه را ندارید.</p>
        <a href="/" class="btn-home">بازگشت به صفحه اصلی</a>
    </div>
</body>
</html>
