@model List<CustomerLogoViewModel>
@{
    var thing = Model?.FirstOrDefault();
    ViewData["Title"] = "لیست لوگوی مشتریان";
}

<div class="container-fluid">

    <!--Header Breadcrumb-->
    <div class="row page-titles">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active">
                <a href="javascript:void(0)">@ViewData["Title"]</a>
            </li>
        </ol>
    </div>

    <!--Main Content-->
    <div class="row">
        <div class="col-12" id="data-table-box">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">@ViewData["Title"]</h4>
                    <button type="button" class="btn btn-primary btn-sm" onclick="LoadCustomerLogoFormModal(0)">
                        <i class="fa fa-plus me-1"></i> افزودن لوگوی جدید
                    </button>
                </div>

                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table id="example3" class="display" style="min-width: 845px">
                                <thead>
                                    <tr>
                                        <th>@(thing != null ? Html.DisplayNameFor(t => thing.Logo) : "لوگو")</th>
                                        <th>@(thing != null ? Html.DisplayNameFor(t => thing.LogoAlt) : "عنوان/توضیح")</th>
                                        <th>@(thing != null ? Html.DisplayNameFor(t => thing.Link) : "لینک")</th>
                                        <th>@(thing != null ? Html.DisplayNameFor(t => thing.Order) : "اولویت")</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (CustomerLogoViewModel item in Model)
                                    {
                                        <tr id="ListItem-@(item.Id)">
                                            <td>
                                                <img src="@(string.IsNullOrWhiteSpace(item.Logo) ? FilePaths.CustomerLogo
                                                                                              : $"{FilePaths.CustomerLogo}{item.Logo}")" width="100" height="60" style="object-fit: contain;" />
                                            </td>
                                            <td>@item.LogoAlt</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(item.Link))
                                                {
                                                    <a href="@item.Link" target="_blank" class="text-primary">مشاهده لینک</a>
                                                }
                                            </td>
                                            <td>@item.Order</td>
                                            <td>
                                                <div class="d-flex">
                                                    <a href="javascript:void(0)" onclick="LoadCustomerLogoFormModal('@item.Id')" class="btn btn-primary shadow btn-xs sharp me-1" title="ویرایش">
                                                        <i class="fa fa-pencil"></i>
                                                    </a>
                                                    <a href="javascript:void(0)" onclick="DeleteCustomerLogo('@item.Id')" class="btn btn-danger shadow btn-xs sharp me-1" title="حذف">
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center my-4 py-4">
                            <i class="fa fa-info-circle fa-2x mb-2 text-info"></i>
                            <p class="mb-3">هنوز هیچ لوگویی ثبت نشده است.</p>
                            <button type="button" onclick="LoadCustomerLogoFormModal(0)" class="btn btn-success btn-sm">
                                <i class="fa fa-plus me-1"></i> ثبت اولین لوگو
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
