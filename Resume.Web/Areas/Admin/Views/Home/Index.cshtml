@{
    ViewData["Title"] = "داشبورد مدیریت";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active"><a href="javascript:void(0)">داشبورد</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0)">صفحه اصلی</a></li>
        </ol>
    </div>

    <!-- Welcome Hero Card -->
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card bg-primary text-white shadow-sm mb-4">
                <div class="card-body p-4 p-md-5">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center mb-3">
                                <img src="~/panel/images/logo.png" alt="لوگو" class="rounded-circle bg-white p-2 shadow-sm me-3" style="max-height: 70px; max-width: 70px; object-fit: contain;" />
                                <div>
                                    <h2 class="text-white font-w700 mb-1">پنل مدیریت وب‌سایت رزومه</h2>
                                    <p class="text-white-50 mb-0">سامانه مدیریت محتوای رزومه و نمونه‌کارهای شخصی</p>
                                </div>
                            </div>
                            <p class="fs-15 mb-4 text-white" style="line-height: 1.8;">
                                به پنل مدیریت خوش آمدید. از طریق بخش‌های زیر یا منوی کناری می‌توانید محتوای وب‌سایت خود اعم از مشخصات فردی، متن درباره من، سوابق تحصیلی، تجربیات کاری، مهارت‌ها و پیام‌های ارسالی کاربران را ویرایش و به‌روزرسانی کنید.
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-light text-primary font-w600">
                                    <i class="fa fa-external-link-alt me-2"></i>مشاهده وب‌سایت
                                </a>
                                <a asp-area="Admin" asp-controller="Information" asp-action="Index" class="btn btn-outline-light font-w600">
                                    <i class="fa fa-user-edit me-2"></i>ویرایش مشخصات فردی
                                </a>
                            </div>
                        </div>
                        <div class="col-md-4 text-center mt-4 mt-md-0 d-none d-md-block">
                            <i class="fa fa-id-card text-white-50" style="font-size: 8rem; opacity: 0.35;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Cards -->
    <div class="row">
        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card card-hover shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="avatar bg-primary-light text-primary rounded p-3 me-3">
                        <i class="fa fa-user fs-24"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 font-w600">اطلاعات فردی</h5>
                        <p class="text-muted mb-2 fs-13">مشخصات، بیوگرافی و تماس</p>
                        <a asp-area="Admin" asp-controller="Information" asp-action="Index" class="btn btn-sm btn-outline-primary">مدیریت</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card card-hover shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="avatar bg-success-light text-success rounded p-3 me-3">
                        <i class="fa fa-graduation-cap fs-24"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 font-w600">سوابق تحصیلی</h5>
                        <p class="text-muted mb-2 fs-13">مدارک و مقاطع تحصیلی</p>
                        <a asp-area="Admin" asp-controller="Education" asp-action="Index" class="btn btn-sm btn-outline-success">مدیریت</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card card-hover shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="avatar bg-warning-light text-warning rounded p-3 me-3">
                        <i class="fa fa-briefcase fs-24"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 font-w600">سوابق شغلی</h5>
                        <p class="text-muted mb-2 fs-13">تجربیات و سوابق کاری</p>
                        <a asp-area="Admin" asp-controller="Experience" asp-action="Index" class="btn btn-sm btn-outline-warning">مدیریت</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-3">
            <div class="card card-hover shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="avatar bg-info-light text-info rounded p-3 me-3">
                        <i class="fa fa-code fs-24"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 font-w600">مهارت‌ها</h5>
                        <p class="text-muted mb-2 fs-13">مهارت‌های فنی و تخصصی</p>
                        <a asp-area="Admin" asp-controller="Skill" asp-action="Index" class="btn btn-sm btn-outline-info">مدیریت</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Second row of cards -->
    <div class="row">
        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-header border-0 pb-0">
                    <h5 class="card-title font-w600">
                        <i class="fa fa-layer-group text-primary me-2"></i>نمونه‌کارها و پروژه‌ها
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted fs-14">مدیریت پروژه‌ها، تصاویر، دسته‌بندی‌ها و لینک‌های مرتبط با نمونه کارهای انجام شده.</p>
                    <div class="d-flex gap-2">
                        <a asp-area="Admin" asp-controller="Portfolio" asp-action="Index" class="btn btn-sm btn-primary">لیست پروژه‌ها</a>
                        <a asp-area="Admin" asp-controller="PortfolioCategory" asp-action="Index" class="btn btn-sm btn-outline-secondary">دسته‌بندی‌ها</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-header border-0 pb-0">
                    <h5 class="card-title font-w600">
                        <i class="fa fa-envelope text-warning me-2"></i>پیام‌های دریافتی
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted fs-14">مشاهده و مدیریت پیام‌های ارسال شده از طریق فرم تماس وب‌سایت توسط بازدیدکنندگان.</p>
                    <a asp-area="Admin" asp-controller="Message" asp-action="Index" class="btn btn-sm btn-warning">مشاهده پیام‌ها</a>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-12 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-header border-0 pb-0">
                    <h5 class="card-title font-w600">
                        <i class="fa fa-check-circle text-success me-2"></i>وضعیت سامانه
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0 fs-14">
                        <li class="mb-2 d-flex align-items-center">
                            <i class="fa fa-check text-success me-2"></i>
                            <span>احراز هویت کوکی امن: <strong>فعال</strong></span>
                        </li>
                        <li class="mb-2 d-flex align-items-center">
                            <i class="fa fa-check text-success me-2"></i>
                            <span>محافظت در برابر CSRF: <strong>فعال</strong></span>
                        </li>
                        <li class="mb-2 d-flex align-items-center">
                            <i class="fa fa-check text-success me-2"></i>
                            <span>تقویم و تاریخ شمسی: <strong>یکپارچه</strong></span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
