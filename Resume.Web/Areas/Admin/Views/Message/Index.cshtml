@model List<MessageViewModel>
@{
    var thing = Model?.FirstOrDefault();
    ViewData["Title"] = "پیام‌های دریافتی";
}

<div class="container-fluid">

    <!--Header Breadcrumb-->
    <div class="row page-titles">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active">
                <a href="javascript:void(0)">@ViewData["Title"]</a>
            </li>
        </ol>
    </div>

    <!--Main Content-->
    <div class="row">
        <div class="col-12" id="data-table-box">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">@ViewData["Title"]</h4>
                </div>

                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table id="example3" class="display" style="min-width: 845px">
                                <thead>
                                    <tr>
                                        <th>@(thing != null ? Html.DisplayNameFor(t => thing.Name) : "نام")</th>
                                        <th>@(thing != null ? Html.DisplayNameFor(t => thing.Email) : "ایمیل")</th>
                                        <th>@(thing != null ? Html.DisplayNameFor(t => thing.Text) : "متن پیام")</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (MessageViewModel item in Model)
                                    {
                                        <tr id="ListItem-@(item.Id)">
                                            <td>@item.Name</td>
                                            <td>@item.Email</td>
                                            <td>@item.Text</td>
                                            <td>
                                                <div class="d-flex">
                                                    <a href="javascript:void(0)" onclick="DeleteMessage('@item.Id')" class="btn btn-danger shadow btn-xs sharp me-1" title="حذف">
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center my-4 py-4">
                            <i class="fa fa-envelope-open fa-2x mb-2 text-info"></i>
                            <p class="mb-0">هنوز هیچ پیامی دریافت نشده است.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
