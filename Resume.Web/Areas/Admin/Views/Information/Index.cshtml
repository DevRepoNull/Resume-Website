@model InformationViewModel
@{
    ViewData["Title"] = "اطلاعات من";
    bool hasData = Model != null && Model.Id > 0;
}

<div class="container-fluid">

    <!--Header Breadcrumb-->
    <div class="row page-titles">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active">
                <a href="javascript:void(0)">@ViewData["Title"]</a>
            </li>
        </ol>
    </div>

    <!--Main Content-->
    <div class="row">
        <div class="col-12" id="data-table-box">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">مشخصات و اطلاعات پروفایل</h4>
                    <button type="button" class="btn btn-primary btn-sm" onclick="LoadInformationFormModal()">
                        <i class="fa fa-@(hasData ? "pencil" : "plus") me-1"></i>
                        @(hasData ? "ویرایش اطلاعات من" : "ثبت اطلاعات جدید")
                    </button>
                </div>

                <div class="card-body">
                    @if (hasData)
                    {
                        <div class="row">
                            <div class="col-xl-3 col-lg-4 text-center mb-4">
                                <div class="profile-photo">
                                    <img src="@(string.IsNullOrWhiteSpace(Model.Avatar) ? FilePaths.DefaultAvatar : $"{FilePaths.Avatar}{Model.Avatar}")"
                                         class="img-fluid rounded-circle shadow" width="160" height="160" alt="Avatar">
                                </div>
                                <h4 class="mt-3 mb-1 text-dark">@Model.Name</h4>
                                <p class="text-muted">@Model.Job</p>
                                @if (!string.IsNullOrWhiteSpace(Model.ResumeFile))
                                {
                                    <a href="@($"{FilePaths.Resume}{Model.ResumeFile}")" target="_blank" class="btn btn-outline-primary btn-sm mt-2">
                                        <i class="fa fa-download me-1"></i> دانلود فایل رزومه
                                    </a>
                                }
                            </div>

                            <div class="col-xl-9 col-lg-8">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped">
                                        <tbody>
                                            <tr>
                                                <th style="width: 25%;">نام و نام خانوادگی</th>
                                                <td>@Model.Name</td>
                                            </tr>
                                            <tr>
                                                <th>شغل و حرفه</th>
                                                <td>@Model.Job</td>
                                            </tr>
                                            <tr>
                                                <th>درباره من (بیوگرافی)</th>
                                                <td style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.AboutMe) ? "ثبت نشده" : Model.AboutMe)</td>
                                            </tr>
                                            <tr>
                                                <th>پست الکترونیک</th>
                                                <td>@Model.EmailAddress</td>
                                            </tr>
                                            <tr>
                                                <th>شماره تماس</th>
                                                <td>@Model.PhoeNumber</td>
                                            </tr>
                                            <tr>
                                                <th>تاریخ تولد</th>
                                                <td>@Model.DateOfBirth</td>
                                            </tr>
                                            <tr>
                                                <th>نشانی و آدرس</th>
                                                <td>@Model.Address</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.MapSrc))
                                {
                                    <div class="mt-3">
                                        <h5 class="text-dark mb-2">پیش‌نمایش نقشه:</h5>
                                        <div class="ratio ratio-21x9 rounded overflow-hidden shadow-sm" style="max-height: 220px;">
                                            <iframe src="@Model.MapSrc" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center py-5 my-3">
                            <i class="fa fa-info-circle fa-3x mb-3 text-info"></i>
                            <h4 class="alert-heading text-dark">هنوز اطلاعاتی ثبت نشده است!</h4>
                            <p class="text-muted mb-4">برای نمایش مشخصات در صفحه اصلی و سایدبار رزومه، لطفاً اطلاعات پروفایل خود را ثبت کنید.</p>
                            <button type="button" onclick="LoadInformationFormModal()" class="btn btn-primary">
                                <i class="fa fa-plus me-1"></i> ثبت اطلاعات من
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
