@model List<ThingIDoViewModel>
@{
    var thing = Model?.FirstOrDefault();
    ViewData["Title"] = "لیست کارهایی که انجام میدم";
}

<div class="container-fluid">

    <!--Header Breadcrumb-->
    <div class="row page-titles">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active">
                <a href="javascript:void(0)">@ViewData["Title"]</a>
            </li>
        </ol>
    </div>

    <!--Main Content-->
    <div class="row">
        <div class="col-12" id="data-table-box">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">@ViewData["Title"]</h4>
                    <button type="button" class="btn btn-primary btn-sm" onclick="LoadThingIDoFromModal(0)">
                        <i class="fa fa-plus me-1"></i> افزودن جدید
                    </button>
                </div>

                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table id="example3" class="display" style="min-width: 845px">
                                <thead>
                                    <tr>
                                        <th>@(thing != null ? Html.DisplayNameFor(t => thing.Title) : "عنوان")</th>
                                        <th>@(thing != null ? Html.DisplayNameFor(t => thing.Description) : "توضیحات")</th>
                                        <th>@(thing != null ? Html.DisplayNameFor(t => thing.ColumnLg) : "اندازه ستون")</th>
                                        <th>@(thing != null ? Html.DisplayNameFor(t => thing.Order) : "اولویت")</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (ThingIDoViewModel item in Model)
                                    {
                                        <tr id="ListItem-@(item.Id)">
                                            <td>@item.Title</td>
                                            <td>@item.Description</td>
                                            <td>@item.ColumnLg</td>
                                            <td>@item.Order</td>
                                            <td>
                                                <div class="d-flex">
                                                    <a href="javascript:void(0)" onclick="LoadThingIDoFromModal('@item.Id')" class="btn btn-primary shadow btn-xs sharp me-1" title="ویرایش">
                                                        <i class="fa fa-pencil"></i>
                                                    </a>
                                                    <a href="javascript:void(0)" onclick="DeleteThingIDo('@item.Id')" class="btn btn-danger shadow btn-xs sharp me-1" title="حذف">
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center my-4 py-4">
                            <i class="fa fa-info-circle fa-2x mb-2 text-info"></i>
                            <p class="mb-3">هنوز داده‌ای برای «کارهایی که انجام میدم» ثبت نشده است.</p>
                            <button type="button" onclick="LoadThingIDoFromModal(0)" class="btn btn-success btn-sm">
                                <i class="fa fa-plus me-1"></i> ثبت اولین مورد
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
