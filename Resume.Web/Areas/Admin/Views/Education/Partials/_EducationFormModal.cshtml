@model UpsertEducationViewModel
@{
    bool isCreate = Model.Id == 0 ? true : false;
}

<!-- Start Form -->
<form id="EducationForm" asp-area="Admin" asp-controller="Education" asp-action="SubmitEducationFormModal" method="post"
      data-ajax="true" data-ajax-begin="StartLoading" data-ajax-success="EducationFormSubmited">
    @Html.AntiForgeryToken()

    <!--Modal Header-->
    <div class="modal-header">
        <h5 class="modal-title">@(isCreate ? "ایجاد تحصیلات جدید" : "ویرایش تحصیلات")</h5>
    </div>

    <!--Modal Body-->
    <div class="modal-body">

        <div class="form-validation">

            <div class="row">
                <div class="col-xl-12">

                    @if (!isCreate)
                    {
                        <input type="hidden" asp-for="Id" />
                    }

                    <div class="mb-3 row">
                        <label class="col-lg-3 col-form-label" asp-for="Title">
                            @Html.DisplayNameFor(t => Model.Title)
                            <span class="text-danger">*</span>
                        </label>
                        <div class="col-lg-9">
                            <input type="text" class="form-control" asp-for="Title" placeholder="مثال: کارشناسی مهندسی کامپیوتر">
                            <small>
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </small>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-lg-3 col-form-label" asp-for="Description">
                            @Html.DisplayNameFor(t => Model.Description)
                        </label>
                        <div class="col-lg-9">
                            <textarea class="form-control" asp-for="Description" rows="3" placeholder="توضیحات و گرایش"></textarea>
                            <small>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </small>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-lg-3 col-form-label" asp-for="StartDate">
                            @Html.DisplayNameFor(t => Model.StartDate)
                            <span class="text-danger">*</span>
                        </label>
                        <div class="col-lg-9">
                            <div class="input-group">
                                <span class="input-group-text cursor-pointer btn-persian-datepicker" id="pdtp-edu-start" title="انتخاب تاریخ شمسی">
                                    <i class="fa fa-calendar"></i>
                                </span>
                                <input type="text" class="form-control persian-date-picker" asp-for="StartDate" id="StartDate" placeholder="مثال: 1398/07/01 یا 1398">
                            </div>
                            <small class="text-muted d-block mt-1">می‌توانید از تقویم شمسی انتخاب کنید یا سال را وارد نمایید.</small>
                            <small>
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </small>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-lg-3 col-form-label" asp-for="EndDate">
                            @Html.DisplayNameFor(t => Model.EndDate)
                            <span class="text-danger">*</span>
                        </label>
                        <div class="col-lg-9">
                            <div class="input-group">
                                <span class="input-group-text cursor-pointer btn-persian-datepicker" id="pdtp-edu-end" title="انتخاب تاریخ شمسی">
                                    <i class="fa fa-calendar"></i>
                                </span>
                                <input type="text" class="form-control persian-date-picker" asp-for="EndDate" id="EndDate" placeholder="مثال: 1402/04/31 یا 1402">
                            </div>
                            <small class="text-muted d-block mt-1">می‌توانید از تقویم شمسی انتخاب کنید یا سال را وارد نمایید.</small>
                            <small>
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </small>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-lg-3 col-form-label" asp-for="Order">
                            @Html.DisplayNameFor(t => Model.Order)
                            <span class="text-danger">*</span>
                        </label>
                        <div class="col-lg-9">
                            <input type="number" class="form-control" asp-for="Order">
                            <small>
                                <span asp-validation-for="Order" class="text-danger"></span>
                            </small>
                        </div>
                    </div>

                </div>
            </div>

        </div>

    </div>

    <!--Modal Footer-->
    <div class="modal-footer">
        <button type="button" class="btn btn-danger light" data-bs-dismiss="modal">
            بستن
        </button>
        <button type="submit" class="btn @(isCreate ? "btn-success" : "btn-primary")">
            @(isCreate ? "ذخیره اطلاعات" : "ویرایش اطلاعات")
        </button>
    </div>
</form>
<!--End Form-->
