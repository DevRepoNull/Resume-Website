<!DOCTYPE html>
<html dir="rtl" lang="en">

<head>
    <partial name="Partials/_AdminHeaderRefrencePartial" />
    
    @await RenderSectionAsync("Style", false)
</head>

<body>
    <div id="main-wrapper">
        @Html.AntiForgeryToken()

        <!--Loader Screen-->
        <div id="preloader">
            <div class="loader">
                <span>Resume</span>
                <span>Admin</span>
            </div>
        </div>

        <!--Nav header-->
        <div class="nav-header">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="brand-logo">
                <img src="~/panel/images/logo.png" alt="لوگو" class="logo-abbr rounded" style="max-height: 48px; max-width: 48px; object-fit: contain;" />
                <div class="brand-title">
                    <h4 class="mb-0 font-w700 text-primary">رزومه من</h4>
                    <span class="fs-12 text-muted">پنل مدیریت</span>
                </div>
            </a>
            <div class="nav-control">
                <div class="hamburger">
                    <span class="line"></span><span class="line"></span><span class="line"></span>
                </div>
            </div>
        </div>

        <div class="header">
            <partial name="Partials/_AdminHeaderPartial" />
        </div>

        <!--Side Bar Menu-->
        <div class="deznav">
            <partial name="Partials/_AdminSidebarMenuPartial" />
        </div>

        <!-- Main content-->
        <div class="content-body">
            
            <!--Bootstrap Modal-->
            <div class="bootstrap-modal">
                <!--Modal Content-->
                <div class="modal fade bd-example-modal-lg" id="modal-main" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-lg">

                        <!--Modal Content-->
                        <div class="modal-content" id="modal-main-content">

                        </div>

                    </div>
                </div>
            </div>

            @RenderBody()
        </div>

    </div>

    <!--Footer-->
    <partial name="Partials/_AdminFooterRefrencePartial" />
    <partial name="Partials/_MessagePartial" />
    
    @await RenderSectionAsync("Script", false)
</body>

</html>
