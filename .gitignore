## =========================================================================
## .gitignore for .NET Core / .NET 10 & ASP.NET Core (Visual Studio, Rider, VS Code)
## =========================================================================

# -------------------------------------------------------------------------
# 1. Build Results & Compiler Artifacts (خروجی‌های کامپایل و بیلد)
# -------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
apphost.exe
*.apphost.exe
*.dll
*.pdb
*.exe
*.tmp
*.temp

# Exceptions: keep binaries if explicitly required (none currently)
!**/wwwroot/**/*.dll

# -------------------------------------------------------------------------
# 2. Visual Studio & IDE Workspace Files (فایل‌ها و پوشه‌های اختصاصی IDE)
# -------------------------------------------------------------------------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vsidx
slnx.sqlite
.sln.DotSettings.user
*.DotSettings.user
*.DotSettings

# JetBrains Rider & IntelliJ
.idea/
*.iml
*.Rider/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# -------------------------------------------------------------------------
# 3. Sensitive Configuration & Local Secrets (تنظیمات محلی و اطلاعات حساس)
# -------------------------------------------------------------------------
# Local and development configuration containing connection strings or certificates
**/appsettings.Development.json
**/appsettings.*.local.json
**/appsettings.Production.json
**/secrets.json

# Certificates & Private Keys
*.pfx
*.p12
*.pem
*.key

# -------------------------------------------------------------------------
# 4. Front-End Package Managers & Dependencies (مدیریت پکیج‌های فرانت‌اند)
# -------------------------------------------------------------------------
# Node / NPM / Yarn
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# NOTE on wwwroot/lib/:
# The project currently stores essential client-side assets (Bootstrap, jQuery, etc.)
# directly in 'Resume.Web/wwwroot/lib' without a package manager (LibMan/NPM).
# Do NOT uncomment the line below unless a client-side package restore (e.g., LibMan) is configured.
# Resume.Web/wwwroot/lib/

# -------------------------------------------------------------------------
# 5. Operating System Generated Files (فایل‌های موقت سیستم‌عامل)
# -------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/
ehthumbs.db
ehthumbs_vista.db

# -------------------------------------------------------------------------
# 6. Test Results & Code Coverage (نتایج تست و ارزیابی کد)
# -------------------------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# -------------------------------------------------------------------------
# 7. Database & Local Storage Files (فایل‌های موقت پایگاه‌داده)
# -------------------------------------------------------------------------
*.mdf
*.ldf
*.ndf
*.db-shm
*.db-wal
